# Set to your public production URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://zagjobsearch.vercel.app
# Keep your existing backend URL in Vercel.
NEXT_PUBLIC_API_URL=
# Paste the Google Search Console HTML-tag verification token here.
GOOGLE_SITE_VERIFICATION=
# Same secret as backend, server-side only. Enables production reminder cron.
CRON_SECRET=
# Optional comma-separated public company board identifiers.
PUBLIC_SMARTRECRUITERS_BOARDS=AmaliTech,WACSI,Sumundi,DevelopersInVogue,JobsForHumanity

# Optional server-only backend URL override for this deployment.
BACKEND_API_URL=
